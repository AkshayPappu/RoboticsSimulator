{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RoboticsSimulator Scene",
  "description": "Schema for scene definition files used by the Robotics Simulator",
  "type": "object",
  "required": ["name"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Human-readable scene name"
    },
    "gravity": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3,
      "default": [0, -9.81, 0],
      "description": "Gravitational acceleration vector [x, y, z]"
    },
    "ground": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["plane", "heightmap"],
          "default": "plane"
        },
        "friction": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "default": 0.5
        },
        "restitution": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.1
        },
        "heightmap_path": {
          "type": "string",
          "description": "Path to heightmap image (only for heightmap type)"
        },
        "height_scale": {
          "type": "number",
          "default": 10.0
        }
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["box", "sphere", "cylinder", "ramp", "wall"]
          },
          "size": {
            "type": "array",
            "items": { "type": "number" },
            "description": "Dimensions — meaning depends on type: box=[sx,sy,sz], cylinder=[radius,height]"
          },
          "radius": {
            "type": "number",
            "description": "Radius for sphere type"
          },
          "length": {
            "type": "number",
            "description": "Length for ramp type"
          },
          "slope": {
            "type": "number",
            "description": "Slope angle in degrees for ramp type",
            "minimum": 0,
            "maximum": 89
          },
          "position": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 3,
            "maxItems": 3,
            "default": [0, 0, 0]
          },
          "mass": {
            "type": "number",
            "minimum": 0,
            "default": 0,
            "description": "Mass in kg. 0 = static/fixed body"
          },
          "friction": {
            "type": "number",
            "minimum": 0,
            "maximum": 2,
            "default": 0.5
          }
        }
      }
    },
    "robot_spawn": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3,
      "default": [0, 0.5, 0],
      "description": "Robot spawn position [x, y, z]"
    }
  }
}
